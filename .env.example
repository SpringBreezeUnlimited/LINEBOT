# Required
SECRET_KEY=replace_with_long_random_string
ADMIN_PASSWORD_HASH=replace_with_werkzeug_hash
AUDIT_ADMIN_PASSWORD_HASH=replace_with_separate_werkzeug_hash
CHANNEL_ACCESS_TOKEN=replace_with_line_channel_access_token
CHANNEL_SECRET=replace_with_line_channel_secret
DATABASE_URL=postgresql://user:password@host:5432/dbname
REDIS_URL=
REDIS_ENTRA_ID_ENABLED=false
REDIS_ENTRA_IDENTITY_TYPE=system_assigned
REDIS_ENTRA_ID_CLIENT_ID=
REDIS_ENTRA_ID_RESOURCE=https://redis.azure.com/

# Security / runtime tuning
APP_ENV=development
SESSION_COOKIE_SECURE=true
FORCE_HTTPS=true
# 信頼するリバースプロキシの段数。アプリを直接公開する場合は 0。
TRUSTED_PROXY_HOPS=1
ALLOWED_HOSTS=example.com,api.example.com
SESSION_IDLE_TIMEOUT_SECONDS=1800
LOGIN_MAX_ATTEMPTS=10
LOGIN_WINDOW_SECONDS=300
WEBHOOK_RATE_LIMIT_COUNT=120
WEBHOOK_RATE_LIMIT_WINDOW_SECONDS=60
# 同一LINEユーザー単位のメッセージ処理制限
USER_REQUEST_RATE_LIMIT_COUNT=10
USER_REQUEST_RATE_LIMIT_WINDOW_SECONDS=60
WEBHOOK_ASYNC_WORKERS=4
# Webhookのmetricログはmetric=webhook_received / webhook_request / webhook_backgroundで出力されます。
ADMIN_REFRESH_INTERVAL_MS=15000
MAX_TYPE_NAME_LENGTH=40
MAX_USER_MESSAGE_CHARS=100
DB_CONNECT_TIMEOUT=5
MAX_REQUEST_BODY_BYTES=67108864
MAX_BACKUP_FILE_BYTES=52428800
MAX_TYPE_IMAGE_UPLOAD_BYTES=10485760
MAX_TYPE_PRICE=99998
PUBLIC_BASE_URL=https://example.com
CALL_TIMEOUT_MINUTES=15
LINE_PUSH_MAX_RETRIES=3
LINE_PUSH_RETRY_BASE_SECONDS=1
LINE_PUSH_RETRY_MAX_SECONDS=8

# 負荷テスト専用。本番環境では LOAD_TEST_MODE を絶対に true にしないこと。
LOAD_TEST_MODE=false
LOAD_TEST_TOKEN=

# Optional
BATCH_CALL_RUNNER_TOKEN=replace_with_long_random_token
# 危険な操作。全アカウントの予約一括削除を有効にする場合だけ true にする。
ENABLE_GLOBAL_RESERVATION_DELETE=false
PORT=5000
